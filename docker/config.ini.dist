; Default config baked into the image at /app/sync/config.ini.
; api_key is left blank on purpose: when talking to a local Lidarr the sync reads it
; from Lidarr's own config.xml automatically, so a base install only needs the cookie.
[lidarr]
url = http://localhost:8686
api_key =
root_folder = /media/music
quality_profile_id = 1
metadata_profile_id = 1
language_profile_id = 1
album_folder = true
monitor_albums = true

[ytmusic]
headers_file =
auth =
oauth_client_id =
oauth_client_secret =
oauth_token_file = /config/ytmusic-oauth.json